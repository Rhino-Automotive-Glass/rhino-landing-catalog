# Copy to .env.local and fill in your existing service credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=

# PostHog project token (public, not a personal API key).
# Leave blank to disable PostHog. US host shown; EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (see docs/google-analytics.md). NEXT_PUBLIC_* values are
# inlined at BUILD time: change them in Vercel, then redeploy.
# Empty or invalid ID disables GA. GA only collects on NEXT_PUBLIC_SITE_URL's
# hostname (previews, *.vercel.app and localhost stay off unless GA_DEBUG=true).
# GA Admin: keep Enhanced Measurement OFF (page views are sent manually;
# leaving it on double-counts every page and sends raw URLs).
NEXT_PUBLIC_GA_ID=G-P4B7CBWF83
NEXT_PUBLIC_SITE_URL=https://rhinoautoglass.mx
# "true" only for local/preview QA in GA DebugView; ignored on the production host.
NEXT_PUBLIC_GA_DEBUG=false
